{
  "name": "@zkscan/core",
  "version": "2.0.0",
  "description": "Privacy-preserving blockchain explorer using zero-knowledge proofs",
  "main": "dist/cjs/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:circuits": "node scripts/build-circuits.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "benchmark": "node benchmarks/run-all.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docs": "typedoc src/index.ts",
    "build:cjs": "tsc -p tsconfig.json --module commonjs --outDir dist/cjs",
    "build:esm": "tsc -p tsconfig.json --module esnext --outDir dist/esm",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly --outDir dist/types"
  },
  "keywords": [
    "blockchain",
    "circom",
    "cryptography",
    "explorer",
    "groth16",
    "pedersen",
    "poseidon",
    "privacy",
    "sdk",
    "solana",
    "zero knowledge",
    "zero-knowledge",
    "zk",
    "zk-snark"
  ],
  "author": "zkScan Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkscan/zkscan-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/zkscan/zkscan-sdk/issues"
  },
  "homepage": "https://zkscan.app",
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.5",
    "ffjavascript": "^0.3.1",
    "@solana/web3.js": "^1.95.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./cli": "./dist/cli/zkscan.js"
  },
  "bin": {
    "zkscan": "dist/cli/zkscan.js"
  }
}